# Server-only TMDB API Read Access Token
# Copy this file to .env when implementation begins and replace the placeholder.
# Store the raw token only; server code adds the Bearer authorization scheme.
# Never expose this token through a variable beginning with VITE_.
TMDB_API_READ_TOKEN=replace_with_your_tmdb_api_read_access_token

# Browser-visible PostHog DEVELOPMENT project configuration
#
# These values are intentionally exposed to browser code by Vite.
# Use only:
# - the frontend-safe project token for the single PickTonight analytics project; and
# - that project's ingestion host.
#
# Never place a PostHog personal API key, administrative credential,
# account secret, or other privileged token in a VITE_ variable.
#
# Issue #38 uses the same physical PostHog project for development,
# preview, and pilot. Reviewed event properties provide the traffic boundary.
# Issue #38 compatibility note:
# These DEV-named variables remain because the existing local configuration
# already uses them. They configure the one PickTonight PostHog project for
# development, preview, and pilot. Test mode never delivers events.
VITE_POSTHOG_DEV_PROJECT_TOKEN=replace_with_your_posthog_development_project_token
VITE_POSTHOG_DEV_HOST=replace_with_your_posthog_development_ingestion_host

# PickTonight analytics runtime classification
#
# Allowed browser-visible values:
# - development
# - test
# - preview
# - pilot
#
# Development and Vitest have safe built-in fallbacks. A generic production
# build fails closed to preview/internal. A real participant pilot deployment
# must deliberately set this value to pilot.
VITE_PICKTONIGHT_ANALYTICS_ENVIRONMENT=development
